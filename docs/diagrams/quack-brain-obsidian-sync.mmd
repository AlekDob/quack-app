%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#FF6B35', 'secondaryColor': '#004E89', 'tertiaryColor': '#1a1a2e'}}}%%
flowchart TB
    subgraph USER["User / AI Agent"]
        U1[Claude Code]
        U2[Quack App UI]
    end

    subgraph MCP["MCP Brain Server"]
        M1[brain_create_entity]
        M2[brain_add_observation]
        M3[brain_search]
        M4[brain_get_backlinks]
        M5[brain_get_wikilinks]
    end

    subgraph SQLITE["SQLite Database"]
        DB1[(entities)]
        DB2[(observations)]
        DB3[(relations)]
        DB4[(wikilinks)]
        DB5[(brain_settings)]
    end

    subgraph SYNC["Sync Engine"]
        S1{Auto-sync enabled?}
        S2[entity_to_markdown]
        S3[Parse WikiLinks]
        S4[ensure_diary_exists]
        S5[append_to_diary]
    end

    subgraph VAULT["Obsidian Vault"]
        subgraph DIARY["diary/"]
            D1[2026-01-08.md]
            D2[2026-01-07.md]
        end
        subgraph GLOBAL["global/"]
            G1[patterns/]
            G2[humans/]
            G3[ideas/]
        end
        subgraph PROJECTS["projects/"]
            subgraph PROJ1["quack-app/"]
                P1[components/]
                P2[functions/]
                P3[api/]
                P4[patterns/]
                P5[bugs/]
                P6[tasks/]
            end
        end
    end

    %% User interactions
    U1 --> M1
    U1 --> M2
    U1 --> M3
    U2 --> M1
    U2 --> M3

    %% MCP to Database
    M1 --> DB1
    M1 --> DB2
    M2 --> DB2
    M3 --> DB1
    M4 --> DB4
    M5 --> DB4

    %% Sync flow
    M1 --> S1
    M2 --> S1
    S1 -->|Yes| S2
    S1 -->|No| STOP[Skip sync]
    S2 --> S3
    S3 --> DB4
    S2 --> S4
    S4 --> S5

    %% Output to Vault
    S2 -->|tag=component| P1
    S2 -->|tag=function| P2
    S2 -->|tag=pattern + project| P4
    S2 -->|tag=pattern + global| G1
    S2 -->|tag=human| G2
    S4 --> DIARY
    S5 --> D1

    %% Backlinks
    P1 -.->|"[[project]]"| PROJ1
    P2 -.->|"[[project]]"| PROJ1
    P4 -.->|"[[2026-01-08]]"| D1

    classDef primary fill:#FF6B35,stroke:#fff,color:#fff
    classDef secondary fill:#004E89,stroke:#fff,color:#fff
    classDef accent fill:#F7931E,stroke:#fff,color:#fff
    classDef dark fill:#1a1a2e,stroke:#444,color:#fff

    class M1,M2,M3,M4,M5 primary
    class DB1,DB2,DB3,DB4,DB5 secondary
    class S2,S3,S4,S5 accent
    class DIARY,GLOBAL,PROJECTS dark
