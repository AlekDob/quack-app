#!/usr/bin/env bash
# Auto-regenerate workstream INDEX.md + CLAUDE.md Current Focus block
# when the commit touches any workstream file. Mirrors what
# scripts/build-workstream-index.py does on demand; here it runs
# automatically so that whoever made the workstream edit (Claude,
# VS Code, manual sed) doesn't have to remember.
#
# Installed via: scripts/install-git-hooks.sh
# Source: project-ops skill — keep in sync if you patch the skill.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Only act if a workstream file is staged.
if git diff --cached --name-only | grep -qE '^documentation/workstreams/[0-9]{2}-.*\.md$'; then
    if ! python3 scripts/build-workstream-index.py; then
        echo "[pre-commit] build-workstream-index.py failed — fix the workstream frontmatter and re-commit." >&2
        exit 1
    fi
    # If the regen changed INDEX.md or the Current Focus block in CLAUDE.md,
    # stage them so the commit stays consistent.
    if ! git diff --quiet -- documentation/workstreams/INDEX.md CLAUDE.md; then
        echo "[pre-commit] Workstream index was out of date; staging regenerated INDEX.md + CLAUDE.md." >&2
        git add documentation/workstreams/INDEX.md CLAUDE.md
    fi
fi
