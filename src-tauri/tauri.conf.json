{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quack",
  "version": "0.5.0",
  "identifier": "com.quack.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "🦆 Quack",
        "width": 1400,
        "height": 800,
        "minWidth": 1300,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "tabbingIdentifier": "quack-terminal",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.giphy.com https://cdn.jsdelivr.net; connect-src 'self' https://api.giphy.com https://api.github.com https://api.openai.com https://raw.githubusercontent.com https://*.supabase.co https://eu.i.posthog.com https://us.i.posthog.com https://alekdob.gumroad.com https://cdn.jsdelivr.net https://github.com; frame-src 'self' http://localhost:* https://localhost:*; child-src 'self' http://localhost:* https://localhost:*"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["quack"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AlekDob/quack-releases/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../images",
      "../public",
      "node-sdk"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: ALEKSANDAR DOBROHOTOV (FC38UVV3V3)",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": null
    }
  }
}
