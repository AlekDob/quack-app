{
  "name": "quack-app-node-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Node.js SDK wrapper for Claude Agent SDK used by Rust backend",
  "main": "stream-claude.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:chunker": "node lib/code-chunker.test.js",
    "test:chunker:integration": "node lib/code-chunker-integration.test.js",
    "test:embeddings": "node lib/embeddings.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.47",
    "@anthropic-ai/sdk": "^0.72.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "discord.js": "^14.14.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@vitest/ui": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
