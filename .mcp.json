{
  "mcpServers": {
    "puppeteer": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "postgresql": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${FLOW_POSTGRES_URL}"
      ]
    },
    "semantic-search": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src-tauri/node-sdk/semantic-search-mcp-server.js"
      ]
    },
    "brain": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src-tauri/node-sdk/brain-mcp-server.js"
      ]
    }
  }
}
