{
  "name": "quack-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production npm run prepare-node-sdk && tsc -b && vite build",
    "build:secure": "NODE_ENV=production npm run prepare-node-sdk && tsc -b && vite build --minify esbuild",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "npm run build:secure && cargo tauri build",
    "tauri:build:debug": "cargo tauri build --debug",
    "prepare-node-sdk": "cd src-tauri/node-sdk && npm install --production",
    "release:prepare": "git checkout production && git merge main && echo '✅ Ready to release! Run: npm run release:publish'",
    "release:publish": "git push origin production && echo '🚀 Release triggered! Check GitHub Actions for progress.'",
    "release:create-branch": "git checkout -b production && git push -u origin production && git checkout main && echo '✅ Production branch created!'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.14",
    "@anthropic-ai/sdk": "^0.65.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^5.0.68",
    "lucide-react": "^0.553.0",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.53.0",
    "openai": "^6.7.0",
    "prettier": "^3.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tauri-plugin-mic-recorder-api": "^2.0.0",
    "vscode-icons-js": "^11.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/tauricon": "^1.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
