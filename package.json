{
  "name": "quack-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production npm run prepare-node-sdk && tsc -b && vite build",
    "build:secure": "NODE_ENV=production npm run prepare-node-sdk && tsc -b && vite build --minify esbuild",
    "build:analyze": "NODE_ENV=production npm run prepare-node-sdk && tsc -b && vite build && echo '📊 Bundle analysis available at: dist/stats.html'",
    "build:profile": "tsc -b && vite build --profile",
    "build:size": "du -sh dist && echo '' && echo 'JavaScript chunks:' && ls -lh dist/assets/*.js | awk '{print $5, $9}' | sort -hr",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:build": "npm run build && npm run preview",
    "tauri": "cargo tauri",
    "tauri:dev": "./scripts/dev.sh",
    "tauri:build": "npm run build:secure && cargo tauri build && ./scripts/optimize-bundle.sh",
    "tauri:build:intel": "npm run build:secure && cargo tauri build --target x86_64-apple-darwin && ./scripts/optimize-bundle.sh",
    "tauri:build:universal": "npm run build:secure && cargo tauri build --target universal-apple-darwin && ./scripts/optimize-bundle.sh",
    "tauri:build:debug": "cargo tauri build --debug",
    "optimize-bundle": "./scripts/optimize-bundle.sh",
    "prepare-node-sdk": "cd src-tauri/node-sdk && npm install --production",
    "release:prepare": "git checkout production && git merge main && echo '✅ Ready to release! Run: npm run release:publish'",
    "release:publish": "git push origin production && echo '🚀 Release triggered! Check GitHub Actions for progress.'",
    "release:create-branch": "git checkout -b production && git push -u origin production && git checkout main && echo '✅ Production branch created!'",
    "analyze:deps": "npm ls --depth=0 --prod | head -20",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules src-tauri/target",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:dedup": "vitest run src/tests/eventDeduplication.test.ts src/tests/sessionKeyStability.test.ts",
    "test:dev": "VITE_TEST_MODE=true npm run tauri:dev",
    "test:clean": "rm -f ~/Library/Application\\ Support/com.quack.terminal/*-TEST.json && echo '✅ Test data cleaned!'",
    "test:reset": "npm run test:clean && echo '🧪 Starting Quack in TEST MODE...' && npm run test:dev"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.1",
    "@anthropic-ai/sdk": "^0.71.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@types/react-virtualized-auto-sizer": "^1.0.8",
    "@uiw/codemirror-theme-github": "^4.25.3",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.3",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^5.0.68",
    "hterm-umdjs": "^1.4.1",
    "lucide-react": "^0.553.0",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.55.1",
    "openai": "^6.7.0",
    "posthog-js": "^1.301.1",
    "prettier": "^3.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-2d": "^1.29.0",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.2.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tauri-plugin-mic-recorder-api": "^2.0.0",
    "thememirror": "^2.0.1",
    "vscode-icons-js": "^11.6.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tauri-apps/tauricon": "^1.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/ui": "^4.0.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.10",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.13",
    "terser": "^5.44.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.10"
  }
}
