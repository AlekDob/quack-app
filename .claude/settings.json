{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.quack/hooks/brain/session-start.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.quack/hooks/brain/pre-read.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.quack/hooks/brain/pre-write.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.quack/hooks/brain/stop.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./dist/**)",
      "Read(./images/**)",
      "Read(./video/**)",
      "Read(./public/images/**)",
      "Read(./.worktrees/**)",
      "Read(./releases/**)",
      "Read(./plan/**)",
      "Read(./planning/**)",
      "Read(./diagrams/**)",
      "Read(./node-sidecar/**)",
      "Read(./quack-inspector/**)",
      "Read(./.smart-connections/**)",
      "Read(./.obsidian/**)",
      "Read(./src-tauri/target/**)"
    ]
  }
}
