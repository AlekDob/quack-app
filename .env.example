# Gumroad API Configuration
# ⚠️ DO NOT commit your actual .env file to version control!
# Copy this file to .env and replace with your actual credentials

# Your Gumroad Product ID (get it from: https://app.gumroad.com/products → Product settings → Product ID)
# This is used to verify license keys against your Gumroad product
GUMROAD_PRODUCT_ID=your_product_id_here

# Supabase Configuration
# Used for device tracking (max 3 devices per license)
# Get these from: https://app.supabase.com/ → Your Project → Settings → API

# Your Supabase project URL
SUPABASE_URL=https://xxx.supabase.co

# Your Supabase anon/public key (safe to use in client-side code)
SUPABASE_ANON_KEY=your_anon_key_here
