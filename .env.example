# Lemon Squeezy API Configuration
# ⚠️ DO NOT commit your actual .env file to version control!
# Copy this file to .env and replace with your actual credentials

# Your Lemon Squeezy API key (get it from: https://app.lemonsqueezy.com/settings/api)
LEMON_SQUEEZY_API_KEY=your_api_key_here

# Your Lemon Squeezy Store ID (get it from: https://app.lemonsqueezy.com/settings/stores)
LEMON_SQUEEZY_STORE_ID=your_store_id_here
