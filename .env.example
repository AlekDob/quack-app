# Gumroad API Configuration
# ⚠️ DO NOT commit your actual .env file to version control!
# Copy this file to .env and replace with your actual credentials

# Your Gumroad Product ID (get it from: https://app.gumroad.com/products → Product settings → Product ID)
# This is used to verify license keys against your Gumroad product
GUMROAD_PRODUCT_ID=your_product_id_here

# Supabase Configuration
# Used for device tracking (max 3 devices per license)
# Get these from: https://app.supabase.com/ → Your Project → Settings → API

# Your Supabase project URL
SUPABASE_URL=https://xxx.supabase.co

# Your Supabase anon/public key (safe to use in client-side code)
SUPABASE_ANON_KEY=your_anon_key_here

# Frontend Environment Variables (Vite - accessible in React)
# These are prefixed with VITE_ to be exposed to the client-side code
# Used for dynamic app configuration (pricing, features, etc.)

# Supabase URL for frontend (same as above, but accessible in React)
VITE_SUPABASE_URL=https://xxx.supabase.co

# Supabase anon key for frontend (same as above, but accessible in React)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# PostHog Analytics Configuration
# Get these from: https://app.posthog.com/ → Project Settings → Project API Key
# Your PostHog project API key (using VITE_PUBLIC_ prefix as per PostHog convention)
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key_here

# PostHog host (EU or US)
# EU: https://eu.i.posthog.com (default)
# US: https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Enable PostHog in development mode (optional, default: disabled in dev)
# VITE_PUBLIC_POSTHOG_DEV_ENABLED=true
